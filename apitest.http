### 12 — تاریخچه پرداخت موفق: سه تغییر (expected HTTP 200)
GET http://localhost:8080/api/v1/payments/{{payflowSuccessId}}/history?merchantId=65155515656
Accept: application/json

> {%
    client.test("HTTP status should be 200", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    if (response.status === 200) {
        client.test("Response content is correct", function () {
            client.assert(Array.isArray(response.body) && response.body.length === 3, "تاریخچه موفق باید سه رکورد داشته باشد");
            client.assert(response.body[0].newStatus === "PENDING", "مرحله اول باید PENDING باشد");
            client.assert(response.body[1].newStatus === "PROCESSING", "مرحله دوم باید PROCESSING باشد");
            client.assert(response.body[2].newStatus === "SUCCESS", "مرحله آخر باید SUCCESS باشد");
        });
    }
%}

