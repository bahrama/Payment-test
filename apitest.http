### 10 — پردازش پرداخت موفق و دریافت کد 00 (expected HTTP 200)
POST http://localhost:8080/api/v1/payments/{{payflowSuccessId}}/process?merchantId=65155515656
Accept: application/json

> {%
    client.test("HTTP status should be 200", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    if (response.status === 200) {
        client.test("Response content is correct", function () {
            client.assert(response.body.status === "SUCCESS", "وضعیت باید SUCCESS شود");
            client.assert(response.body.gatewayResponseCode === "00", "کد موفقیت درگاه باید 00 باشد");
            client.assert(response.body.gatewayTransactionId && response.body.gatewayTransactionId.startsWith("SIM-"), "شناسه درگاه باید با SIM- آغاز شود");
        });
    }
%}

