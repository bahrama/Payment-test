
### 01 — نمونه خودت: ایجاد پرداخت اولیه (expected HTTP 201)
POST http://localhost:8080/api/v1/payments
Accept: application/json
Content-Type: application/json
Idempotency-Key: 15555555

{
  "merchantId": "65155515656",
  "merchantReference": "616516565165",
  "amount": 125000.50,
  "currency": "IRR"
}

> {%
    client.test("HTTP status should be 201", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
    if (response.status === 201 && response.body && response.body.id) {
        client.global.set("payflowBaseId", response.body.id);
    }
    if (response.status === 201) {
        client.test("Response content is correct", function () {
            client.assert(response.body.merchantId === "65155515656", "merchantId نادرست است");
            client.assert(response.body.merchantReference === "616516565165", "merchantReference نادرست است");
            client.assert(response.body.status === "PENDING", "وضعیت اولیه باید PENDING باشد");
        });
    }
%}

### 02 — دریافت مشخصات پرداخت اولیه (expected HTTP 200)
GET http://localhost:8080/api/v1/payments/{{payflowBaseId}}?merchantId=65155515656
Accept: application/json

> {%
    client.test("HTTP status should be 200", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    if (response.status === 200) {
        client.test("Response content is correct", function () {
            client.assert(response.body.id === client.global.get("payflowBaseId"), "شناسه دریافتی یکسان نیست");
        });
    }
%}

### 03 — تاریخچه اولیه: یک وضعیت PENDING (expected HTTP 200)
GET http://localhost:8080/api/v1/payments/{{payflowBaseId}}/history?merchantId=65155515656
Accept: application/json

> {%
    client.test("HTTP status should be 200", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    if (response.status === 200) {
        client.test("Response content is correct", function () {
            client.assert(Array.isArray(response.body), "پاسخ باید آرایه باشد");
            client.assert(response.body.length === 1, "تاریخچه اولیه باید یک رکورد داشته باشد");
            client.assert(response.body[0].newStatus === "PENDING", "اولین وضعیت باید PENDING باشد");
        });
    }
%}

